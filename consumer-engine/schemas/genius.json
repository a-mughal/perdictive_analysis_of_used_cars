{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genius report",
  "type": "object",
  "required": ["versions", "tooling_and_nre", "price_usd", "fee_stack", "forecast", "mc_inputs", "timeline", "premortem", "idea_rulings", "recommended_first_version", "feasibility_verdict", "three_sentences_to_founder"],
  "properties": {
    "planning_fallacy_multiplier": {"type": "number", "minimum": 1.0},
    "versions": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["version_id", "idea_ids", "bom", "landed_cost_usd"],
        "properties": {"version_id": {"type": "string"}, "idea_ids": {"type": "array", "items": {"type": "string"}},
          "bom": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["part", "qty", "unit_cost_usd"], "properties": {"part": {"type": "string"}, "qty": {"type": "number"}, "unit_cost_usd": {"$ref": "_range.json"}}}},
          "packaging_dims_cm": {"type": "array", "items": {"type": "number"}}, "unit_weight_g": {"type": "number"},
          "unit_cost_exw_usd": {"$ref": "_range.json"}, "landed_cost_usd": {"$ref": "_range.json"}}}},
    "tooling_and_nre": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["item", "cost_usd"], "properties": {"item": {"type": "string"}, "cost_usd": {"$ref": "_range.json"}, "required_for_versions": {"type": "array", "items": {"type": "string"}}}}},
    "fixed_launch_cost_usd": {"$ref": "_range.json"},
    "price_usd": {"$ref": "_range.json"},
    "fee_stack": {"type": "object", "required": ["referral_usd", "fba_usd", "storage_alloc_usd", "returns_alloc_usd", "ad_alloc_usd"],
      "properties": {"referral_usd": {"$ref": "_range.json"}, "fba_usd": {"$ref": "_range.json"}, "storage_alloc_usd": {"$ref": "_range.json"}, "returns_alloc_usd": {"$ref": "_range.json"}, "ad_alloc_usd": {"$ref": "_range.json"}, "any_stale": {"type": "boolean"}}},
    "contribution_per_unit_usd": {"$ref": "_range.json"},
    "break_even_units": {"$ref": "_range.json"},
    "sanity_rails": {"type": "array", "items": {"type": "object", "required": ["rail", "pass"], "properties": {"rail": {"type": "string"}, "pass": {"type": "boolean"}, "value": {"type": "string"}}}},
    "forecast": {"type": "object", "required": ["term_monthly_units", "share_m3", "share_m6", "share_m12", "monthly_units_m3", "monthly_units_m6", "monthly_units_m12", "annual_units_y1", "reasoning"],
      "properties": {"term_monthly_units": {"$ref": "_range.json"}, "share_m3": {"$ref": "_range.json"}, "share_m6": {"$ref": "_range.json"}, "share_m12": {"$ref": "_range.json"}, "monthly_units_m3": {"$ref": "_range.json"}, "monthly_units_m6": {"$ref": "_range.json"}, "monthly_units_m12": {"$ref": "_range.json"}, "annual_units_y1": {"$ref": "_range.json"}, "annual_units_y2": {"$ref": "_range.json"}, "seasonality_note": {"type": "string"}, "reasoning": {"type": "string", "minLength": 100}}},
    "mc_inputs": {"type": "object",
      "required": ["price", "landed_cost", "referral_rate", "fba_fee", "storage_alloc", "return_rate", "ad_rate", "monthly_units_m6", "monthly_units_m12", "fixed_launch_cost"],
      "properties": {"price": {"$ref": "_range.json"}, "landed_cost": {"$ref": "_range.json"}, "referral_rate": {"$ref": "_range.json"}, "fba_fee": {"$ref": "_range.json"}, "storage_alloc": {"$ref": "_range.json"}, "return_rate": {"$ref": "_range.json"}, "ad_rate": {"$ref": "_range.json"}, "monthly_units_m6": {"$ref": "_range.json"}, "monthly_units_m12": {"$ref": "_range.json"}, "fixed_launch_cost": {"$ref": "_range.json"}}},
    "timeline": {"type": "object", "required": ["phases", "weeks_to_first_sale"],
      "properties": {"phases": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["phase", "weeks"], "properties": {"phase": {"type": "string"}, "weeks": {"$ref": "_range.json"}, "cost_driver": {"type": "string"}}}}, "weeks_to_first_sale": {"$ref": "_range.json"}}},
    "regulatory": {"type": "array", "items": {"type": "string"}},
    "premortem": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["obituary", "probability", "impact", "mitigation", "mitigation_cost_usd"], "properties": {"obituary": {"type": "string"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}, "impact": {"type": "string", "enum": ["fatal", "major", "minor"]}, "mitigation": {"type": "string"}, "mitigation_cost_usd": {"$ref": "_range.json"}}}},
    "idea_rulings": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["idea_id", "ruling", "why", "deciding_number"], "properties": {"idea_id": {"type": "string"}, "ruling": {"type": "string", "enum": ["realistic", "stretch", "unrealistic"]}, "why": {"type": "string"}, "deciding_number": {"type": "string"}}}},
    "recommended_first_version": {"type": "object", "required": ["version_id", "idea_ids", "landed_cost_usd", "price_usd", "contribution_pct", "break_even_units", "months_to_break_even_base"],
      "properties": {"version_id": {"type": "string"}, "idea_ids": {"type": "array", "items": {"type": "string"}}, "landed_cost_usd": {"$ref": "_range.json"}, "price_usd": {"$ref": "_range.json"}, "contribution_pct": {"$ref": "_range.json"}, "break_even_units": {"$ref": "_range.json"}, "months_to_break_even_base": {"type": "number"}}},
    "feasibility_verdict": {"type": "string", "enum": ["realistic", "stretch", "unrealistic"]},
    "three_sentences_to_founder": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}
  }
}
