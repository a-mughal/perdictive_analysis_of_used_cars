{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Innovaty report",
  "type": "object",
  "required": ["target_spec", "ideas", "errc", "version_plan", "sustainability", "listing_implications", "what_i_cut"],
  "properties": {
    "target_spec": {"type": "object", "required": ["outcomes_targeted", "must_fix_clusters", "should_fix_clusters"],
      "properties": {"outcomes_targeted": {"type": "array", "items": {"type": "string"}}, "must_fix_clusters": {"type": "array", "items": {"type": "string"}}, "should_fix_clusters": {"type": "array", "items": {"type": "string"}}, "over_served_to_cut": {"type": "array", "items": {"type": "string"}}}},
    "ideas": {"type": "array", "minItems": 5, "maxItems": 9,
      "items": {"type": "object",
        "required": ["idea_id", "name", "role", "mechanism", "fixes_complaint_clusters", "improves_outcomes", "improves_gates", "kano_class", "triz_or_erric_tags", "thumbnail_visibility", "cost_tier", "priority", "prior_art_risk", "prior_art_reason", "test_that_proves_it", "how_it_looks_in_main_image", "buyer_sentence"],
        "properties": {
          "idea_id": {"type": "string"}, "name": {"type": "string"},
          "role": {"type": "string", "enum": ["hero", "supporting", "hygiene"]},
          "mechanism": {"type": "string", "minLength": 80},
          "fixes_complaint_clusters": {"type": "array", "items": {"type": "string"}},
          "improves_outcomes": {"type": "array", "items": {"type": "string"}},
          "improves_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "kano_class": {"type": "string", "enum": ["must_be", "performance", "delighter"]},
          "triz_or_erric_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "thumbnail_visibility": {"type": "string", "enum": ["high", "medium", "low"]},
          "cost_tier": {"type": "string", "enum": ["free", "cents", "dimes", "dollars", "tooling"]},
          "tooling_note": {"type": "string"},
          "priority": {"type": "string", "enum": ["now", "later"]},
          "prior_art_risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "prior_art_reason": {"type": "string"},
          "test_that_proves_it": {"type": "string"},
          "how_it_looks_in_main_image": {"type": "string"},
          "buyer_sentence": {"type": "string"},
          "durability_reliability_note": {"type": "string"}
        }}},
    "errc": {"type": "object", "required": ["eliminate", "reduce", "raise", "create"],
      "properties": {"eliminate": {"type": "array", "items": {"type": "string"}}, "reduce": {"type": "array", "items": {"type": "string"}}, "raise": {"type": "array", "items": {"type": "string"}}, "create": {"type": "array", "items": {"type": "string"}}}},
    "hero_as_product": {"type": "string", "minLength": 200},
    "version_plan": {"type": "object", "required": ["v1_now", "v2_later"],
      "properties": {"v1_now": {"type": "array", "items": {"type": "string"}}, "v2_later": {"type": "array", "items": {"type": "object", "required": ["idea_id", "unlock_trigger"], "properties": {"idea_id": {"type": "string"}, "unlock_trigger": {"type": "string"}}}}}},
    "sustainability": {"type": "object", "required": ["claims"], "properties": {"claims": {"type": "array", "items": {"type": "object", "required": ["claim", "verification"], "properties": {"claim": {"type": "string"}, "verification": {"type": "string"}}}}, "rejected_claims": {"type": "array", "items": {"type": "string"}}}},
    "listing_implications": {"type": "object", "required": ["title_first_60", "main_image_brief", "image_briefs_2_to_6", "honest_limitations"],
      "properties": {"title_first_60": {"type": "string", "maxLength": 80}, "main_image_brief": {"type": "string"}, "image_briefs_2_to_6": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}}, "honest_limitations": {"type": "array", "minItems": 2, "items": {"type": "string"}}}},
    "what_i_cut": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  }
}
